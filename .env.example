# ─────────────────────────────────────────────────────────────────────────────
# Jeera environment variables — copy to `.env` and fill in for local/Docker use.
# `.env` is gitignored. docker-compose reads it automatically.
# ─────────────────────────────────────────────────────────────────────────────

# Active Spring profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# HTTP port (Render injects PORT automatically in production)
PORT=8080

# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/jeera_db
DB_USERNAME=jeera_user
DB_PASSWORD=yourpassword

# ── JPA tuning (optional) ────────────────────────────────────────────────────
# JPA_DDL_AUTO=update
# JPA_SHOW_SQL=true
# THYMELEAF_CACHE=false

# ─────────────────────────────────────────────────────────────────────────────
# Reserved for upcoming roadmap milestones (not used yet):
# ── GitHub integration (M5) ──
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# ── Attachment storage (M8) ──
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT=
